cabal-version:      3.0
name:               peg
version:            0.1.0.0
category:           Parsing
build-type:         Simple

executable peg
    main-is:            Main.hs
    build-depends:
        base >= 4.7 && < 5,
        peg-matching,
        typed-peg >= 0.5
    hs-source-dirs:     .
    default-language:   Haskell2010